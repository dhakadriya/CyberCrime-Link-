# ============================================================
# CrimeLink Environment Configuration
# Copy this file to .env and fill in your values
# NEVER commit the actual .env file
# ============================================================

# --- Database ---
DATABASE_URL=postgresql+asyncpg://crimelink_user:CHANGE_ME_DB_PASSWORD@localhost:5432/crimelink_db
DATABASE_URL_SYNC=postgresql://crimelink_user:CHANGE_ME_DB_PASSWORD@localhost:5432/crimelink_db

# --- JWT ---
# Generate with: python -c "import secrets; print(secrets.token_hex(64))"
JWT_SECRET=CHANGE_ME_GENERATE_A_STRONG_64_CHAR_HEX_SECRET
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# --- Security ---
MAX_FAILED_ATTEMPTS=5
LOCKOUT_DURATION_MINUTES=30

# --- File Upload ---
# Bytes: 52428800 = 50MB
MAX_UPLOAD_SIZE=52428800
UPLOAD_DIRECTORY=./evidence_storage

# --- CORS ---
# Comma-separated list of allowed origins
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# --- Environment ---
ENVIRONMENT=development
DEBUG=false
LOG_LEVEL=INFO

# --- Seed Password (development only) ---
# Used by the seed script to create demo users
SEED_DEFAULT_PASSWORD=CHANGE_ME_SEED_PASSWORD_MIN_12_CHARS

# --- Frontend (for Docker) ---
VITE_API_BASE_URL=http://localhost:8000
