.pytest_cache/
htmlcov/
.coverage
coverage.xml

# Node / Frontend
node_modules/
frontend/dist/
frontend/build/
*.log
npm-debug.log*

# Evidence storage - never commit uploaded files
evidence_storage/*
!evidence_storage/.gitkeep

# IDE
.vscode/
.idea/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# Docker
docker/postgres-data/

